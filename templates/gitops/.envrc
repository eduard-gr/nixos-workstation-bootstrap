# Requires direnv + nix-direnv. Run `direnv allow` once after cloning.
use flake

# Keep cluster credentials local to this repo (both files must be gitignored).
# export TALOSCONFIG="$PWD/talosconfig"
# export KUBECONFIG="$PWD/kubeconfig"

# Optional per-user overrides that are not committed.
source_env_if_exists .envrc.local
